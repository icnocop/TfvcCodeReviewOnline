{
    "compilerOptions": {
        "target": "ES2018",
        "lib": [ "ES2018", "DOM", "DOM.Iterable" ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [ "node" ]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
