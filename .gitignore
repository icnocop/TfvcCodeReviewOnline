# Node
node_modules/
npm-debug.log*

# Build output. The packaged .vsix is produced into bin/, so it is already covered.
#
# Do NOT add a bare `*.vsix` rule here: gitignore patterns without a trailing slash match
# directories as well as files, so `*.vsix` also matches the src/TfvcCodeReviewOnline.Vsix
# directory and silently excludes the entire packaging project.
bin/
obj/
test-results/

# The TypeScript bundle is generated by the build, not checked in.
src/TfvcCodeReviewOnline.Web/wwwroot/js/

# Backups written by scripts\Set-WorkItemFormExtension.ps1. These are work item type definitions
# exported from a real server and contain project names and account names, so they must never be
# committed. The script defaults its backup location to the current directory, which is inside the
# repository whenever it is run from here.
*.backup.xml

# Editors
.vs/
.idea/
*.user
*.suo

# OS
Thumbs.db
.DS_Store
